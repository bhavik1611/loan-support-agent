# Copy to .env and fill in. .env is gitignored and never committed.
# Names only live here; a value never does.

# mock (default, offline, every graded transcript) or groq.
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=groq.
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=

# Optional. DEBUG, INFO, WARNING (default), ERROR.
LOG_LEVEL=
