{
  "$defs": {
    "GuardrailBlock": {
      "additionalProperties": false,
      "description": "Which guardrails fired. Present on every response, including refusals.",
      "properties": {
        "grounded": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grounded"
        },
        "injection_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Injection Rule"
        },
        "pii_masked": {
          "items": {
            "type": "string"
          },
          "title": "Pii Masked",
          "type": "array"
        }
      },
      "title": "GuardrailBlock",
      "type": "object"
    },
    "LookupBlock": {
      "additionalProperties": false,
      "description": "What the record route produced.\n\n`source` is fixed at \"record\" per D-41: this text came from a template\nover the row's own fields with no model call behind it, so it must be\ndistinguishable in the envelope from a grounded answer.",
      "properties": {
        "customer_context": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customer Context"
        },
        "days_since_created": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Days Since Created"
        },
        "escalation_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Escalation Score"
        },
        "flagged_for_fraud_review": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flagged For Fraud Review"
        },
        "found": {
          "title": "Found",
          "type": "boolean"
        },
        "loan_amount_inr": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loan Amount Inr"
        },
        "recommend_escalation": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommend Escalation"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "source": {
          "const": "record",
          "default": "record",
          "title": "Source",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        }
      },
      "required": [
        "record_id",
        "found"
      ],
      "title": "LookupBlock",
      "type": "object"
    },
    "PolicyBlock": {
      "additionalProperties": false,
      "description": "What the RAG route produced. Absent on every other route.\n\n`outcome` is the field that keeps the two out-of-scope refusals apart\n(D-54). \"refused_gate\" means the product gate of spec 8.5 stopped the\nquery before retrieval and `top1_similarity` is 0.0 because nothing was\nsearched; \"refused_threshold\" means retrieval ran and T or the support\nrule refused. Reading `supported` alone cannot tell them apart, and a\ngrader checking criterion 24a against 24b needs to.\n\nThe names are spec section 9.4's, not new ones, so the agent's envelope\nand Part 1's evaluation table say the same word for the same event.",
      "properties": {
        "citations": {
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "outcome": {
          "default": "answered",
          "enum": [
            "answered",
            "refused_gate",
            "refused_threshold"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "product": {
          "default": "",
          "title": "Product",
          "type": "string"
        },
        "strategy": {
          "title": "Strategy",
          "type": "string"
        },
        "supported": {
          "title": "Supported",
          "type": "boolean"
        },
        "top1_similarity": {
          "title": "Top1 Similarity",
          "type": "number"
        }
      },
      "required": [
        "top1_similarity",
        "supported",
        "strategy"
      ],
      "title": "PolicyBlock",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The envelope. Part 3 Task 11 uses this as its FastAPI response model.",
  "properties": {
    "answer": {
      "title": "Answer",
      "type": "string"
    },
    "guardrails": {
      "$ref": "#/$defs/GuardrailBlock"
    },
    "lookup": {
      "anyOf": [
        {
          "$ref": "#/$defs/LookupBlock"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyBlock"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "route": {
      "enum": [
        "policy",
        "lookup",
        "both",
        "clarify",
        "refused"
      ],
      "title": "Route",
      "type": "string"
    },
    "thread_id": {
      "title": "Thread Id",
      "type": "string"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    },
    "turn": {
      "title": "Turn",
      "type": "integer"
    }
  },
  "required": [
    "trace_id",
    "thread_id",
    "turn",
    "route",
    "answer",
    "guardrails"
  ],
  "title": "AgentResponse",
  "type": "object"
}
